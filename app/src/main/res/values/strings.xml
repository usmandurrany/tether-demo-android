    <string name="hint_allow_scram_sha1">For old servers without SHA-256.</string>

    <string name="section_background">In the background</string>
    <string name="mode_close">Disconnect (push notifications)</string>
    <string name="mode_close_hint">Closes cleanly 5 s after the app is hidden, so the server stores messages and sends push.</string>
    <string name="mode_detach">Detach, resume on return</string>
    <string name="mode_detach_hint">Drops the socket but keeps the session resumable, for a fast return.</string>
    <string name="mode_stay">Stay connected</string>
    <string name="mode_stay_hint">Keeps the connection open and tells the server the app is inactive (CSI).</string>
    <string name="auto_connect">Connect on app start</string>
    <string name="hint_auto_connect">Uses the saved login.</string>

    <string name="section_chats">Chats</string>
    <string name="auto_accept">Accept contact requests automatically</string>
    <string name="hint_auto_accept">Anyone who adds you sees when you\'re online and is added back. Off by default.</string>
    <string name="keep_messages">Keep chats on this device</string>
    <string name="hint_keep_messages">Ticks, read state, deletions and photos survive a restart. Off keeps them in memory only.</string>
    <string name="profiles">Profiles and pictures</string>
    <string name="hint_profiles">Your name and picture for contacts, and theirs in your lists (vCard). On by default.</string>

